# ===================================================================== FitForge
# Kopieren nach .env und anpassen. Schlüssel erzeugen mit:
#   docker run --rm ghcr.io/zendonir/fitness_ai:latest python -m app.cli gen-keys

# --- Allgemein
TZ=Europe/Berlin
PUID=568                      # TrueNAS-Standardbenutzer "apps" (568) – oder eigene UID
PGID=568
PUBLIC_URL=https://fitforge.example.de   # Externe URL (für Passkeys, Links, OIDC). OHNE Slash am Ende
DATA_ROOT=/mnt/tank/apps/fitforge        # Dataset mit Unterordnern postgres/ redis/ uploads/ backups/
FITFORGE_IMAGE=ghcr.io/zendonir/fitness_ai:latest

# --- Sicherheit (unbedingt ändern!)
SECRET_KEY=bitte-mit-gen-keys-erzeugen
FERNET_KEY=bitte-mit-gen-keys-erzeugen   # Master-Key für verschlüsselte API-Keys & 2FA-Secrets – sicher aufbewahren!
POSTGRES_PASSWORD=bitte-mit-gen-keys-erzeugen

# --- Erster Admin (wird nur angelegt, wenn noch kein Benutzer existiert; danach entfernen)
ADMIN_EMAIL=admin@example.de
ADMIN_PASSWORD=ein-langes-sicheres-passwort

# --- Netzwerk (macvlan: eigene IP im LAN)
MACVLAN_PARENT=eno1           # Netzwerkkarte des TrueNAS-Hosts (ip link)
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
LAN_IP_RANGE=192.168.1.240/29 # Bereich außerhalb des DHCP-Pools
APP_IP=192.168.1.241          # Feste IP der App (innerhalb LAN_IP_RANGE)

# --- KI (optional – kann auch im Admin-Panel gesetzt werden)
AI_ENABLED=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=              # z. B. http://192.168.1.50:11434
DEFAULT_AI_PROVIDER=anthropic # anthropic | openai | ollama
DEFAULT_ANTHROPIC_MODEL=claude-opus-5
DEFAULT_OPENAI_MODEL=gpt-5
DEFAULT_OLLAMA_MODEL=llama3.1
AI_DEFAULT_MONTHLY_LIMIT_USD=10

# --- Web Push (VAPID) – mit gen-keys erzeugen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.de

# --- OIDC / SSO (optional, z. B. Authentik)
OIDC_ISSUER=                  # z. B. https://auth.example.de/application/o/fitforge/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=Authentik
OIDC_AUTO_CREATE=false        # true: unbekannte SSO-Benutzer automatisch anlegen
OIDC_ADMIN_GROUP=             # Mitglieder dieser Gruppe werden Admin (nur bei Neuanlage)

# --- Backups (pg_dump nach DATA_ROOT/backups)
BACKUP_HOUR=3
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
